{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' > /dev/tty"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a' > /dev/tty"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"\\(.model.display_name) | \\(.context_window.used_percentage // 0)% context | Rate limit: \\(.rate_limits.five_hour.used_percentage // 0)%\"'"
  }
}
