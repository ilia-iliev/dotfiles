general {
        colors = true
        output_format = "i3bar"
        interval = 5
}

order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "[W] %quality"
        format_down = ""
}

ethernet _first_ {
        format_up = "[E] %speed"
        format_down = ""
}

battery all {
        format = "[B] %percentage"
        format_down = ""
}

disk "/" {
        format = "[D] %avail"
}

load {
        format = "[C] %1min"
}

memory {
        format = "[M] %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%H:%M:%S"
}
