#!/usr/bin/env bash
# Flush and unmount USB media before unplugging it. Names are matched as typed
# first, then ignoring case.
#   unmount Kindle    unmount kindle    unmount ~/media/drives/Kindle    unmount --all
set -uo pipefail

ROOT="/run/media/$USER"

mounted() { findmnt -rn -o TARGET | grep "^$ROOT/" ; }

# Echoes the mounted path that $1 refers to: exactly as typed if that is
# mounted, otherwise the one mount whose name matches ignoring case.
resolve() {
    local input=$1 path base name
    local -a hits=()

    [[ -d $input ]] || input="$ROOT/$input"
    path=$(readlink -m "$input")

    if mountpoint -q "$path"; then
        printf '%s\n' "$path"
        return 0
    fi

    base=${path##*/}
    while read -r path; do
        name=${path##*/}
        [[ ${name,,} == "${base,,}" ]] && hits+=("$path")
    done < <(mounted)

    case ${#hits[@]} in
        1) printf '%s\n' "${hits[0]}" ;;
        0) echo "not mounted: $base" >&2; return 1 ;;
        *) echo "ambiguous: $base matches ${hits[*]}" >&2; return 1 ;;
    esac
}

unmount_one() {
    local path=$1 unit
    unit=$(systemd-escape --path --suffix=mount "$path") || return 1
    if systemctl stop "$unit"; then
        echo "safe to unplug: $path"
    else
        echo "could not unmount $path (something is still using it?)" >&2
        return 1
    fi
}

target=${1-}

if [[ -z $target ]]; then
    echo "usage: unmount <name|path|--all>" >&2
    echo "mounted now:" >&2
    mounted | sed 's/^/  /' >&2 || echo "  (nothing)" >&2
    exit 1
fi

if [[ $target == --all ]]; then
    rc=0
    while read -r path; do unmount_one "$path" || rc=1; done < <(mounted)
    exit $rc
fi

target=$(resolve "$target") || exit 1
unmount_one "$target"
