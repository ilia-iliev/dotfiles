# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        output_format = "i3bar"
        interval = 5
}

order += "battery all"
order += "load"
order += "memory"
order += "disk /"
order += "ethernet _first_"
order += "wireless _first_"
order += "tztime local"

wireless _first_ {
        format_up = "[W] %quality"
        format_down = ""
}

ethernet _first_ {
        format_up = "%speed"
        format_down = ""
}

battery all {
        format = "[B] %percentage"
        format_down = ""
}

disk "/" {
        format = "[D] %avail"
}

load {
        format = "[C] %1min"
}

memory {
        format = "[M] %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%H:%M"
}
